doctype html
html(lang='es')
    head
        meta(charset='UTF-8')
        meta(name='viewport', content='width=device-width, initial-scale=1.0')
        title La Espiga de Oro - Gestión de Productos y Pedidos
        link(rel='stylesheet' href='/styles.css')
    body
        header.topbar
            .topbar-inner
                .brand
                    .brand-mark LE
                    .brand-info
                        h1.brand-title La Espiga de Oro S.R.L
                        p.brand-subtitle Panel de gestión interno

                if usuario
                    nav.navbar(aria-label='Navegación principal')
                        a.nav-link(href='/')
                            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                path(d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z")
                                polyline(points="9 22 9 12 15 12 15 22")
                            span Inicio
                        a.nav-link(href='/pedidos')
                            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                rect(width="8" height="4" x="8" y="2" rx="1" ry="1")
                                path(d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2")
                            span Pedidos
                        if usuario.rol !== 'admin'
                            a.nav-link(href='/pedidos/nuevo')
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                    path(d="M5 12h14")
                                    path(d="M12 5v14")
                                span Nuevo pedido
                        if usuario.rol === 'admin'
                            a.nav-link(href='/productos')
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                    path(d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z")
                                    path(d="m3.3 7 8.7 5 8.7-5")
                                    path(d="M12 22V12")
                                span Productos
                            a.nav-link(href='/sucursales')
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                    path(d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7")
                                    path(d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8")
                                    path(d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4")
                                span Sucursales
                            a.nav-link(href='/stock')
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                    path(d="M3 3h18")
                                    path(d="M3 9h18")
                                    path(d="M3 15h18")
                                    path(d="M3 21h18")
                                span Stock
                        span.user-pill
                            svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" style="stroke: var(--primary)")
                                path(d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2")
                                circle(cx="12" cy="7" r="4")
                            span #{usuario.nombre} (#{usuario.rol})
                        form.logout-form(method='POST', action='/logout')
                            button(type='submit')
                                svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" style="stroke: var(--danger)")
                                    path(d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4")
                                    polyline(points="16 17 21 12 16 7")
                                    line(x1="21" x2="9" y1="12" y2="12")
                                span Salir

        main.container
            block content

        footer.footer
            p &copy; 2026 Parabellum Devs · Todos los derechos reservados.

        include chat-widget.pug
        script(src='/socket.io/socket.io.js')
        script(src='/chat.js')
