doctype html
html(lang='es')
    head
        meta(charset='UTF-8')
        meta(name='viewport', content='width=device-width, initial-scale=1.0')
        title Parabellum Devs - Gestión de Productos y Pedidos
        link(rel='stylesheet' href='/styles.css')

        style.
            input {
                border: 1px solid #ccc;
                background: white;
                font-size: 16px;
                padding: 6px;
                border-radius: 4px;
            }  
    body
        header
            h1 Parabellum Devs - La Espiga de Oro S.R.L


            if usuario
                nav
                    a(href='/') Inicio
                    |  |
                    a(href='/pedidos') Pedidos
                    |  |
                    a(href='/pedidos/nuevo') Nuevo Pedido
                    if usuario.rol === 'admin'
                        |  |
                        a(href='/productos') Productos
                        |  |
                        a(href='/productos/nuevo') Nuevo Producto
                    |  |
                    span Hola, #{usuario.nombre} (#{usuario.rol})
                    |  |
                    form(method='POST', action='/logout', style='display:inline')
                        button(type='submit') Cerrar sesión

        hr

        main.container
            block content

        hr

        footer
            p &copy; 2026 Parabellum Devs - Todos los derechos reservados.
