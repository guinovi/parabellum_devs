extends layout

block content
    section.page-hero
        p.eyebrow Productos
        h1 Lista de productos
        p Catálogo vigente de La Espiga de Oro.
        .actions
            a.btn.btn-primary(href='/productos/nuevo')
                svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--surface)")
                    path(d="M12 5v14")
                    path(d="M5 12h14")
                span Crear producto

    .table-wrapper
        table
            thead
                tr
                    th ID
                    th Nombre
                    th Precio
                    th Tipo
                    th Activo
                    th Acción
            tbody
                each producto in productos
                    tr
                        td(data-label="ID") #{producto.id}
                        td(data-label="Nombre") #{producto.nombre}
                        td(data-label="Precio") $#{producto.precio}
                        td(data-label="Tipo")
                            span.badge.badge-propia #{producto.tipo}
                        td(data-label="Activo")
                            span.badge(class=producto.activo ? 'badge-activo' : 'badge-inactivo') #{producto.activo ? 'Sí' : 'No'}
                        td
                            .actions
                                button.btn-secondary(type='button' onclick=`window.location.href='/productos/editar/${producto.id}'`)
                                    svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                        path(d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z")
                                    span Editar
                                button.btn-danger(type='button' onclick=`eliminarProducto('${producto.id}')`)
                                    svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                        path(d="M3 6h18")
                                        path(d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6")
                                        path(d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2")
                                    span Eliminar
                else
                    tr
                        td.empty-state(colspan='6') No hay productos cargados.

    script.
        async function eliminarProducto(id) {
            const confirmacion = confirm('¿Eliminar producto?');
            if (!confirmacion) return;

            try {
                const response = await fetch(`/productos/${id}`, { method: 'DELETE' });
                if (response.ok) {
                    window.location.reload();
                } else {
                    alert('Error al eliminar');
                }
            } catch (error) {
                console.error(error);
                alert('Error de red al eliminar');
            }
        }
