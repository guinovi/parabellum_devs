extends layout

block content
    section.page-hero
        p.eyebrow Productos
        h1 Nuevo producto
        p Cargá un producto nuevo para el catálogo.

    form.form-card(method='POST', action='/productos')
        .form-grid
            .form-group
                label(for='nombre') Nombre del Producto
                input#nombre(type='text', name='nombre', required, placeholder='Ej. Criollos de Hoja')
            .form-group
                label(for='precio') Precio ($)
                input#precio(type='number', name='precio', required, placeholder='Ej. 1200')
            .form-group
                label(for='tipo') Tipo / Categoría
                input#tipo(type='text', name='tipo', required, placeholder='Ej. Panificados')
            .form-group.checkbox-group
                input#activo(type='checkbox', name='activo' checked)
                label(for='activo' style="margin: 0; cursor: pointer;") Producto disponible para pedidos

        .actions(style="margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1.5rem;")
            button.btn-primary(type='submit')
                svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--surface)")
                    path(d="M5 12h14")
                    path(d="M12 5v14")
                span Crear producto
            a.btn.btn-secondary(href='/productos') Cancelar
