extends layout

block content
    section.page-hero
        p.eyebrow Pedidos
        h1 Nuevo pedido
        p Seleccioná cantidades y generá un pedido para la fecha indicada.

    form.form-card(method='POST', action='/pedidos' onsubmit='return validarPedido()')
        .form-group(style="margin-bottom: 2rem; max-width: 320px;")
            label(for='fecha') Fecha de Entrega
            input#fecha(type='date', name='fecha', required, value=fechaHoy)

        h2(style="color: var(--primary); font-size: 1.5rem; font-weight: 800; border-bottom: 2px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1.5rem;") Catálogo de Productos

        .form-grid
            each producto in productos
                - const stock = stockMap[producto.id]
                - const maxPermitido = stock ? Math.max(0, stock.cantidad - stock.minimo) : 0
                .form-group
                    label(for='cantidad_' + producto.id)
                        | #{producto.nombre}
                        if stock
                            span(style="font-size: 0.75rem; color: var(--text-muted); margin-left: 0.5rem;") (máx: #{maxPermitido} #{stock.unidad})
                        else
                            span(style="font-size: 0.75rem; color: var(--danger); margin-left: 0.5rem;") (sin stock)
                    input(
                        id='cantidad_' + producto.id
                        type='number'
                        name='cantidad_' + producto.id
                        min='0'
                        max=maxPermitido
                        value='0'
                        data-max=maxPermitido
                        data-nombre=producto.nombre
                        data-unidad=(stock ? stock.unidad : 'unidad')
                        onchange='validarCampo(this)'
                    )
                    span.error-stock(id='error_' + producto.id style="color: var(--danger); font-size: 0.8rem; display: none;")

        .actions(style="margin-top: 2.5rem; border-top: 1px solid var(--border); padding-top: 1.5rem;")
            button.btn-primary(type='submit')
                svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--surface)")
                    path(d="M12 5v14")
                    path(d="M5 12h14")
                span Crear pedido
            a.btn.btn-secondary(href='/pedidos') Cancelar

    script.
        function validarCampo(input) {
            const max = Number(input.dataset.max);
            const valor = Number(input.value);
            const nombre = input.dataset.nombre;
            const unidad = input.dataset.unidad;
            const errorEl = document.getElementById('error_' + input.id.replace('cantidad_', ''));

            if (valor > max) {
                input.value = max;
                errorEl.textContent = `Máximo permitido: ${max} ${unidad}`;
                errorEl.style.display = 'block';
            } else {
                errorEl.style.display = 'none';
            }
        }

        function validarPedido() {
            const inputs = document.querySelectorAll('input[type="number"][data-max]');
            for (const input of inputs) {
                const max = Number(input.dataset.max);
                const valor = Number(input.value);
                if (valor > max) {
                    alert(`La cantidad de "${input.dataset.nombre}" supera el máximo permitido (${max} ${input.dataset.unidad})`);
                    input.focus();
                    return false;
                }
            }
            return true;
        }