extends layout

block content
    section.page-hero
        p.eyebrow Stock
        h1 Stock de productos
        p Inventario actual de La Espiga de Oro.
        .actions
            a.btn.btn-primary(href='/stock/cargar')
                svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--surface)")
                    path(d="M12 5v14")
                    path(d="M5 12h14")
                span Cargar stock

    .table-wrapper
        table
            thead
                tr
                    th ID
                    th Producto
                    th Cantidad
                    th Unidad
                    th Stock mínimo
                    th Estado
            tbody
                each stock in stocks
                    tr
                        td(data-label="ID") #{stock.producto}
                        td(data-label="Producto") #{stock.nombreProducto}
                        td(data-label="Cantidad") #{stock.cantidad}
                        td(data-label="Unidad") #{stock.unidad}
                        td(data-label="Stock mínimo") #{stock.stockMinimo}
                        td(data-label="Estado")
                            if stock.bajominimo
                                span.badge.badge-inactivo Stock bajo
                            else
                                span.badge.badge-activo OK
                else
                    tr
                        td.empty-state(colspan='6') No hay stock registrado.