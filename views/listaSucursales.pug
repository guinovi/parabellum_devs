extends layout

block content
    section.page-hero
        p.eyebrow Sucursales
        h1 Lista de sucursales
        p Filtrá y administrá puntos de venta, franquicias y planta.
        .actions
            a.btn.btn-primary(href='/sucursales/nuevo')
                svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--surface)")
                    path(d="M12 5v14")
                    path(d="M5 12h14")
                span Crear sucursal

    form.filter-bar(method='GET', action='/sucursales')
        .form-group
            label(for='tipo') Filtrar por tipo
            select#tipo(name='tipo')
                option(value='') Todos
                option(value='propia' selected= tipoFiltro === 'propia') Propias
                option(value='franquicia' selected= tipoFiltro === 'franquicia') Franquicias
                option(value='planta' selected= tipoFiltro === 'planta') Planta
        button.btn-primary(type='submit') Aplicar filtro

    .table-wrapper
        table
            thead
                tr
                    th ID
                    th Nombre
                    th Tipo
                    th Dirección
                    th Alias
                    th Ciudad
                    th Provincia
                    th Teléfono
                    th Email
                    th Responsable
                    th Acción
            tbody
                each sucursal in sucursales
                    tr
                        td(data-label="ID") #{sucursal.id}
                        td(data-label="Nombre") #{sucursal.nombre}
                        td(data-label="Tipo")
                            span.badge(class=`badge-${sucursal.tipo}`) #{sucursal.tipo}
                        td(data-label="Dirección") #{sucursal.direccion}
                        td(data-label="Alias") #{sucursal.alias}
                        td(data-label="Ciudad") #{sucursal.ciudad}
                        td(data-label="Provincia") #{sucursal.provincia}
                        td(data-label="Teléfono") #{sucursal.telefono || '-'}
                        td(data-label="Email") #{sucursal.email || '-'}
                        td(data-label="Responsable") #{sucursal.responsable || '-'}
                        td
                            .actions
                                button.btn-secondary(type='button' onclick=`window.location.href='/sucursales/editar/${sucursal.id}'`)
                                    svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                        path(d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z")
                                    span Editar
                                button.btn-danger(type='button' onclick=`eliminarSucursal('${sucursal.id}')`)
                                    svg(xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                                        path(d="M3 6h18")
                                        path(d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6")
                                        path(d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2")
                                    span Eliminar
                else
                    tr
                        td.empty-state(colspan='11') No hay sucursales cargadas.

    script.
        async function eliminarSucursal(id) {
            const confirmacion = confirm('¿Eliminar sucursal? Esto sólo la desactivará.');
            if (!confirmacion) return;

            try {
                const response = await fetch(`/sucursales/${id}`, { method: 'DELETE' });
                if (response.ok) {
                    window.location.reload();
                } else {
                    alert('Error al eliminar sucursal');
                }
            } catch (error) {
                console.error(error);
                alert('Error de red al eliminar sucursal');
            }
        }
