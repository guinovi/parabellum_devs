extends layout

block content
    section.page-hero
        p.eyebrow Pedidos
        h1 Editar pedido
        p Actualizá los detalles de tu pedido.

    form.form-card(id='formEditarPedido')
        input(type='hidden' id='pedidoId' value=pedido.id)
        
        .form-group(style="margin-bottom: 2rem; max-width: 320px;")
            label(for='fecha') Fecha de Entrega
            input#fecha(type='date', name='fecha', required, value=pedido.fecha)

        h2(style="color: var(--primary); font-size: 1.5rem; font-weight: 800; border-bottom: 2px solid var(--border); padding-bottom: 0.5rem; margin-bottom: 1.5rem;") Catálogo de Productos
        
        .form-grid
            each producto in productos
                - const prodEnPedido = pedido.productos.find(p => p.id === producto.id)
                - const cantidad = prodEnPedido ? prodEnPedido.cantidad : 0
                .form-group
                    label(for='cantidad_' + producto.id) #{producto.nombre}
                    input(id='cantidad_' + producto.id class='input-cantidad' data-id=producto.id type='number', min='0', value=cantidad)
        
        .actions(style="margin-top: 2.5rem; border-top: 1px solid var(--border); padding-top: 1.5rem;")
            button.btn-primary(type='submit')
                svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--surface)")
                    path(d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4")
                    polyline(points="16 17 21 12 16 7")
                    line(x1="21" x2="9" y1="12" y2="12")
                span Guardar cambios
            button.btn-secondary(type='button' onclick="window.location.href='/pedidos'") Cancelar

    script.
        document.getElementById('formEditarPedido').addEventListener('submit', async (event) => {
            event.preventDefault();
            const id = document.getElementById('pedidoId').value;
            const fecha = document.getElementById('fecha').value;
            
            const inputsCantidad = document.querySelectorAll('.input-cantidad');
            const productos = [];
            
            inputsCantidad.forEach(input => {
                const cantidad = parseInt(input.value, 10);
                if (cantidad > 0) {
                    productos.push({
                        id: parseInt(input.dataset.id, 10),
                        cantidad: cantidad
                    });
                }
            });

            if (productos.length === 0) {
                alert('Debe seleccionar al menos un producto');
                return;
            }

            const datos = {
                fecha,
                productos
            };

            try {
                const response = await fetch(`/pedidos/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(datos)
                });
                
                if (response.ok) {
                    alert('Pedido actualizado');
                    window.location.href = '/pedidos';
                } else {
                    const errorData = await response.json();
                    alert(errorData.error || 'Error al actualizar');
                }
            } catch (error) {
                console.error(error);
                alert('Error de red al actualizar');
            }
        });
