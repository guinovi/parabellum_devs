extends layout

block content
    section.page-hero
        p.eyebrow Productos
        h1 Editar producto
        p Actualizá los datos principales del producto.

    form.form-card(id='formEditar')
        input(type='hidden' id='productoId' value=producto.id)
        .form-grid
            .form-group
                label(for='nombre') Nombre del Producto
                input#nombre(type='text' value=producto.nombre required)
            .form-group
                label(for='precio') Precio ($)
                input#precio(type='number' value=producto.precio required)
            .form-group
                label(for='categoria') Categoría
                select#categoria(name='categoria', required, onchange='actualizarSubcategorias()')
                    each cat in Object.keys(tipos)
                        option(value=cat, selected=(cat === producto.categoria)) #{cat}
            .form-group
                label(for='subcategoria') Subcategoría
                select#subcategoria(name='subcategoria', required)
                    each sub in (tipos[producto.categoria] || [])
                        option(value=sub, selected=(sub === producto.subcategoria)) #{sub}
            .form-group.checkbox-group
                input#activo(type='checkbox' checked=producto.activo)
                label(for='activo' style="margin: 0; cursor: pointer;") Producto disponible para pedidos

        .actions(style="margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1.5rem;")
            button.btn-primary(type='submit')
                svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="stroke: var(--surface)")
                    path(d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4")
                    polyline(points="16 17 21 12 16 7")
                    line(x1="21" x2="9" y1="12" y2="12")
                span Guardar cambios
            button.btn-secondary(type='button' onclick="window.location.href='/productos'") Cancelar

    script.
        const TIPOS = !{JSON.stringify(tipos)};

        function actualizarSubcategorias() {
            const categoria = document.getElementById('categoria').value;
            const selectSub = document.getElementById('subcategoria');
            const subcategoriaActual = '#{producto.subcategoria}';
            selectSub.innerHTML = '';

            if (!categoria || !TIPOS[categoria]) return;

            TIPOS[categoria].forEach(sub => {
                const option = document.createElement('option');
                option.value = sub;
                option.textContent = sub;
                if (sub === subcategoriaActual) option.selected = true;
                selectSub.appendChild(option);
            });
        }

        document.getElementById('formEditar').addEventListener('submit', async (event) => {
            event.preventDefault();
            const id = document.getElementById('productoId').value;
            const datos = {
                nombre: document.getElementById('nombre').value,
                precio: document.getElementById('precio').value,
                categoria: document.getElementById('categoria').value,
                subcategoria: document.getElementById('subcategoria').value,
                activo: document.getElementById('activo').checked
            };

            try {
                const response = await fetch(`/productos/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(datos)
                });
                if (response.ok) {
                    alert('Producto actualizado');
                    window.location.href = '/productos';
                } else {
                    alert('Error al actualizar');
                }
            } catch (error) {
                console.error(error);
                alert('Error de red al actualizar');
            }
        });